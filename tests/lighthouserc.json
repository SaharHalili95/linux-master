{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8790/?mode=trivia"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "node serve.js 8790",
      "startServerReadyPattern": "Serving HTTP",
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}